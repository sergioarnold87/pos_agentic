<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_agentic" model="ir.ui.view">
        <field name="name">product.template.form.agentic</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Agente de IA" name="agentic_monitoring">
                    <group string="Configuración del Agente">
                        <field name="is_agentic_monitored"/>
                        <field name="agent_stock_priority" widget="priority"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
